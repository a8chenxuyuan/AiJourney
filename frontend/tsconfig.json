{
  // tsconfig.json：前端 TypeScript 编译配置
  // 作用：配置编译目标、模块解析策略、严格类型检查以及路径别名等，确保 TypeScript 正确编译
  "compilerOptions": {
    // target：编译后的 JavaScript 目标版本，选择 ES2020 以支持现代浏览器
    "target": "ES2020",
    // useDefineForClassFields：使用 define 语义处理类字段，符合 ES2022 标准
    "useDefineForClassFields": true,
    // module：模块系统，ESNext 与 Vite 配合最佳
    "module": "ESNext",
    // lib：声明可用的标准库，包含 DOM 操作与 ES2020 语法
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    // skipLibCheck：跳过声明文件（.d.ts）的类型检查，加快编译速度
    "skipLibCheck": true,
    // esModuleInterop：增强 ES 模块与 CommonJS 的互操作性，减少第三方类型声明的兼容问题
    "esModuleInterop": true,
    // allowSyntheticDefaultImports：允许对没有默认导出的模块使用默认导入
    "allowSyntheticDefaultImports": true,

    // moduleResolution：模块解析策略，Bundler 模式适合 Vite 等打包工具
    "moduleResolution": "Bundler",
    // allowImportingTsExtensions：允许在导入时使用 .ts 扩展名，仅用于类型检查阶段
    "allowImportingTsExtensions": true,
    // resolveJsonModule：允许导入 JSON 文件
    "resolveJsonModule": true,
    // isolatedModules：每个文件作为独立模块编译，确保 TSX 等文件安全
    "isolatedModules": true,
    // noEmit：不输出编译产物，由 Vite 负责实际编译
    "noEmit": true,
    // jsx：保留 JSX 语法，交由 Vite 处理
    "jsx": "preserve",

    // strict：开启所有严格类型检查选项
    "strict": true,
    // noUnusedLocals：检查未使用的局部变量
    "noUnusedLocals": true,
    // noUnusedParameters：检查未使用的函数参数
    "noUnusedParameters": true,
    // noFallthroughCasesInSwitch：检查 switch 语句中的 case 是否贯穿
    "noFallthroughCasesInSwitch": true,

    // baseUrl：基础目录，用于解析非相对路径模块
    "baseUrl": ".",
    // paths：路径别名，@ 映射到 ./src，便于模块导入
    "paths": {
      "@/*": ["src/*"]
    }
  },
  // include：需要编译的文件范围
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  // references：引用 tsconfig.node.json，用于 Vite 配置文件本身的类型检查
  "references": [{ "path": "./tsconfig.node.json" }]
}
