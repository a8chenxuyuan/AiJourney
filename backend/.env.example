# agent1旅行 环境变量模板
# 复制本文件为 .env，并填入真实配置值

# ==================== 应用基础配置 ====================
# 应用名称，仅用于日志展示
APP_NAME=agent1旅行

# 运行环境：development / production
ENVIRONMENT=development

# 后端服务监听端口
PORT=8000

# 是否开启调试模式（生产环境请设为 false）
DEBUG=true

# 允许跨域访问的前端地址，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==================== 数据库配置 ====================
# 关系型数据库连接地址
# 开发阶段可使用 SQLite：sqlite+aiosqlite:///./agent1travel.db
# 生产环境建议使用 PostgreSQL：postgresql+asyncpg://user:password@localhost:5432/agent1travel
DATABASE_URL=sqlite+aiosqlite:///./agent1travel.db

# ==================== JWT 认证配置 ====================
# JWT 签名密钥，生产环境请使用足够复杂的随机字符串
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# JWT 签名算法
JWT_ALGORITHM=HS256

# JWT Token 过期时间（分钟）
JWT_EXPIRE_MINUTES=1440

# ==================== LLM 配置（百炼） ====================
# 百炼 API Key，从 https://bailian.console.aliyun.com/ 获取
LLM_API_KEY=sk-ws-H.RXIIPPP.rMRz.MEQCIBLa5nkrFqlzetuLVG0YA1RwUS_uwuprGoJxnz7B4UhKAiBN4MopfPpm7QvglvPg7OYut79Vr2hNy3agV9wnyGaYDQ

# OpenAI 兼容接口地址
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认使用的模型 ID
LLM_MODEL_ID=qwen-max-latest

# Agent 温度参数，越低越稳定
LLM_TEMPERATURE=0.3

# Agent 最大重试次数
AGENT_MAX_RETRIES=3

# Agent 单次调用超时（秒）
AGENT_TIMEOUT=60

# ==================== 高德地图 MCP 配置 ====================
# 高德地图 Web 服务 Key，从 https://console.amap.com/dev/key/app 获取
AMAP_API_KEY=a48db2dd897a8cee966f150911fdb0e8

# ==================== RAG / 向量库配置 ====================
# Qdrant 服务地址
QDRANT_URL=http://localhost:6333

# Qdrant 集合名称
QDRANT_COLLECTION=agent1travel_knowledge

# Embedding 模型名称，支持中文
EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5

# 检索返回的 Top-K 文档数
RAG_TOP_K=5

# ==================== Redis 缓存配置（可选） ====================
# REDIS_URL=redis://localhost:6379/0

# ==================== 爬虫配置 ====================
# 是否启用定时爬虫
CRAWLER_ENABLED=false

# 爬虫定时规则（cron 表达式）：每周一凌晨 3 点执行
CRAWLER_SCHEDULE=0 3 * * 1

# 爬虫请求间隔（秒），避免对目标站点造成压力
CRAWLER_DELAY=2

# 单次爬虫最大抓取页面数
CRAWLER_MAX_PAGES=100

# ==================== 支付配置（沙箱） ====================
# 是否启用支付沙箱
PAYMENT_SANDBOX=true

# 支付宝沙箱 APP ID
ALIPAY_APP_ID=your-sandbox-app-id

# 支付宝沙箱公钥
ALIPAY_PUBLIC_KEY=your-sandbox-public-key

# 支付宝沙箱私钥
ALIPAY_PRIVATE_KEY=your-sandbox-private-key

# 微信支付沙箱配置（可选）
# WECHAT_PAY_MCH_ID=your-mch-id
# WECHAT_PAY_API_KEY=your-api-key
